## Example environment file for the backend.
# Copy this to `backed/.env` and fill in your real API keys locally.
# Do NOT commit `backed/.env` to git. `backed/.env` is ignored by .gitignore.

# Stage 1 · Apollo
APOLLO_API_KEY=your_apollo_api_key_here

# Stage 2 · Prospeo
PROSPEO_API_KEY=your_prospeo_api_key_here

# Stage 3 · Brevo (Sendinblue)
BREVO_API_KEY=your_brevo_api_key_here

# Sender identity (optional)
BREVO_SENDER_EMAIL=you@example.com
BREVO_SENDER_NAME=Your Name
BREVO_CAMPAIGN_LIST_IDS=5

# Notes:
# - Create a local file at `backed/.env` with the same keys and real values.
# - For CI/deploy, store keys in your CI provider (GitHub Actions -> Secrets) and
#   reference them there instead of committing any secret file.
